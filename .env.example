# The Eurovillage Herald — environment variables
#
# Copy this file to .env locally (or set these as Railway service variables
# in production) and fill in real values. NEVER commit a file with real
# secrets in it — .env is already listed in .gitignore.
#
# Local development works with NONE of these set, exactly as it always has:
# Turnstile stays off and uploads keep going to local disk. In production,
# though, "unset" is treated differently for the two Cloudflare features --
# see APP_ENV below and the TURNSTILE_REQUIRED / R2_REQUIRED notes further
# down. Read those before assuming "leave it blank" is silently safe in prod.


# ---------------------------------------------------------------------------
# Environment switch — controls how strict the app is about missing
# Cloudflare configuration (see runtime_env.py)
# ---------------------------------------------------------------------------
# APP_ENV=production makes missing Turnstile config print a loud startup
# warning instead of quietly running unprotected, and makes a BROKEN R2
# config (some but not all R2_* vars set) reject uploads instead of
# silently writing them to local disk. Leave unset locally.
#
# If APP_ENV is left blank, production is inferred from SERVER_NAME being
# set (Railway already sets that), so you likely don't need to set this
# explicitly on Railway -- it's here mainly so you CAN force either mode
# (e.g. APP_ENV=development to test prod-like strictness off, on a machine
# that also happens to have SERVER_NAME set).
#
# Values: "production" (or "prod") / "development" (or "dev", "local").
APP_ENV=


# ---------------------------------------------------------------------------
# Existing: production hostname (already supported before this change)
# ---------------------------------------------------------------------------

# Root domain. When set, the admin panel is served ONLY from
# admin.<SERVER_NAME> instead of <host>/admin/. Leave unset for local dev.
# Also used to infer APP_ENV=production when APP_ENV itself is unset.
SERVER_NAME=

# Usually left at the default (https). Only needed if PREFERRED_URL_SCHEME
# must differ from SERVER_NAME's implied scheme.
PREFERRED_URL_SCHEME=https

# Railway persistent volume mount point used by start.sh. Set by Railway
# itself in most setups; only override if you know you need to.
PERSIST_DIR=/data


# ---------------------------------------------------------------------------
# Cloudflare Turnstile — public-site visitor gate + protected forms
# ---------------------------------------------------------------------------
# Get these from the Cloudflare dashboard: Turnstile > Add widget.
# Obtain: Site Key + Secret Key (Turnstile > your widget > Settings).
#
# Leave both blank in LOCAL DEVELOPMENT to disable the visitor gate AND form
# protection entirely -- the normal, expected state for working locally.
#
# Leaving both blank in PRODUCTION (APP_ENV=production, or SERVER_NAME set)
# is different: the app still starts and still runs unprotected, but it
# prints a large warning banner to the logs on every boot so this is never
# silent. This is the app's CURRENT real state on Railway today, until the
# Cloudflare Turnstile widget below is created and these are set.

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# How many days a visitor's "verified" cookie is trusted before they see the
# gate again. Optional, defaults to 14.
TURNSTILE_COOKIE_DAYS=14

# Optional hard guarantee: once Turnstile is genuinely set up and you want
# the app to REFUSE TO START in production if the keys are ever missing
# again (rather than just warning), set this to true. Defaults to false so
# today's deployment -- which hasn't configured Turnstile yet -- keeps
# running instead of going down. Has no effect outside production.
TURNSTILE_REQUIRED=false


# ---------------------------------------------------------------------------
# Cloudflare Access — optional extra check for the admin panel
# ---------------------------------------------------------------------------
# Cloudflare Access itself is configured entirely in the Cloudflare
# dashboard (Zero Trust > Access > Applications) and is what actually
# protects admin.eurovillageherald.com. These two variables are OPTIONAL and
# only add a defense-in-depth check inside the app itself (verifying the
# signed identity Access attaches to the request). Leave both blank if you
# don't want this extra check -- Access still protects the admin panel
# either way once it's configured in the dashboard.
#
# Obtain: Zero Trust dashboard > Settings > Custom Pages / General ->
# your team domain is "<CF_ACCESS_TEAM_DOMAIN>.cloudflareaccess.com".
# CF_ACCESS_AUD is the "Application Audience (AUD) Tag" shown on the Access
# application you create for admin.eurovillageherald.com.

CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=


# ---------------------------------------------------------------------------
# Cloudflare R2 — media storage (article/author images, PDF newspaper
# editions).
# ---------------------------------------------------------------------------
# Obtain from the Cloudflare dashboard: R2 > Create bucket, then
# R2 > Manage API Tokens > Create API Token (grant it Object Read & Write,
# scoped to this bucket only).
#
# Three distinct states this app treats differently:
#   1. ALL FIVE required vars blank -- "R2 not set up yet". In local
#      development this is silent and expected: uploads go to local disk.
#      In production it's the app's CURRENT real state on Railway today --
#      uploads still go to local disk (nothing breaks), but a warning is
#      printed to the logs on every boot so it's a visible, tracked state
#      rather than an invisible one. Set TURNSTILE_REQUIRED's R2 counterpart,
#      R2_REQUIRED (below), once you want to close that fallback off.
#   2. SOME but not all five set -- always a mistake (typo, incomplete
#      copy-paste). In production this is NEVER treated as "R2 off": any
#      upload is rejected outright with a clear admin-facing error rather
#      than silently landing on local disk. Fix the missing variable(s)
#      named in the startup warning.
#   3. All five set correctly -- uploads go to R2. If an upload to R2 itself
#      fails (bad credentials, network issue, bucket permissions), it is
#      now caught and reported to the admin as a clean error -- it no
#      longer falls back to local disk or crashes with a 500.

# Your Cloudflare account ID (dashboard right sidebar, or R2 overview page).
R2_ACCOUNT_ID=

# The API token's Access Key ID / Secret Access Key (shown once when the
# token is created -- store them somewhere safe, they can't be viewed again).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# The bucket name you created for Herald media, e.g. "eurovillage-herald-media".
R2_BUCKET_NAME=

# Optional override for the S3-compatible API endpoint. Leave blank to use
# the standard https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com derived
# automatically from R2_ACCOUNT_ID above.
R2_ENDPOINT_URL=

# The public custom domain connected to this bucket in the Cloudflare
# dashboard (R2 > your bucket > Settings > Custom Domains). MUST be
# matbaa.eurovillageherald.com per the site's chosen convention -- do not
# use cdn.eurovillageherald.com.
R2_PUBLIC_BASE_URL=https://matbaa.eurovillageherald.com

# Optional hard guarantee: once R2 is genuinely set up (all five vars above
# working), set this to true to make production REFUSE the local-disk
# fallback entirely and forever -- even if R2 later becomes unreachable
# or one of the vars above is accidentally unset again, uploads will fail
# cleanly with an admin-facing error instead of quietly writing to local
# disk. Defaults to false so today's deployment (R2 not configured at all
# yet) keeps accepting uploads via local disk. Has no effect outside
# production.
R2_REQUIRED=false

# Optional, but the ONLY way reader-submitted tip images (contact form
# attachments, stored under okur-ihbarlari/ -- see uploads.save_tip_image)
# get genuine confidentiality rather than just "not linked from anywhere
# public". If unset, tip images are stored in the SAME bucket as public
# media (R2_BUCKET_NAME above), just under their own prefix -- the app
# never generates or shows a public URL for them, but if that bucket's
# R2_PUBLIC_BASE_URL custom domain serves any object by key with no access
# check (the R2 default), someone who obtains the exact object key could
# still fetch it directly, bypassing the admin-only proxy entirely. Create
# a SEPARATE bucket with NO custom domain connected and put its name here
# for a real guarantee -- see CLOUDFLARE_SETUP.md. Uses the same
# R2_ACCOUNT_ID / R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY / R2_ENDPOINT_URL
# above; only the bucket differs.
R2_PRIVATE_BUCKET_NAME=


# ---------------------------------------------------------------------------
# Upload validation
# ---------------------------------------------------------------------------
# Per-file size limits enforced server-side, in megabytes. Optional.

MAX_IMAGE_UPLOAD_MB=8
MAX_PDF_UPLOAD_MB=40

# Maximum number of images a visitor may attach to one contact/tip form
# submission (app/uploads.py: save_tip_image). Each is still subject to
# MAX_IMAGE_UPLOAD_MB above, so the two together bound total submission
# size. Optional, defaults to 4.
MAX_TIP_IMAGES=4


# ---------------------------------------------------------------------------
# Scheduled publishing -- editorial timezone (app/editorial_tz.py)
# ---------------------------------------------------------------------------
# Storage is always UTC (article publish_at, ad start_at/end_at) -- this
# only controls what timezone the CMS displays and accepts scheduling times
# in. An IANA timezone name, e.g. "Europe/Istanbul", "UTC", "America/New_York".
# Optional, defaults to UTC. Uses Python's stdlib zoneinfo (see the
# `tzdata` package in requirements.txt, which bundles the IANA database so
# this works even on a minimal container image without system tzdata).
EDITORIAL_TIMEZONE=UTC


# ---------------------------------------------------------------------------
# Email delivery (app/mailer.py) -- subscription confirmations, contact
# acknowledgements/resolutions, and editorial bulletins/newsletters.
# ---------------------------------------------------------------------------
# Fully optional. Leaving EMAIL_PROVIDER unset (or unrecognized) makes
# mailer.BACKEND "fake": nothing is ever actually sent, but every flow
# (subscribe/confirm/unsubscribe, contact acknowledgements, bulletin sends)
# still runs end to end -- records are created, the durable outbox still
# queues and marks jobs "sent", only the real network call is skipped and
# replaced with a one-line server log (recipient + subject only, never the
# body). This is the correct, expected state for local development and for
# a production deploy that hasn't set up a real provider yet -- see
# /admin/eposta-sistemi (Email System Health) to confirm which backend is
# actually active.
EMAIL_PROVIDER=

# The three sending identities. All three are SENDING-ONLY addresses --
# none of them is ever meant to be a monitored inbox, and this app never
# creates, modifies, or reads any mailbox for them. Leave unset to use the
# sensible defaults baked into app/mailer.py.
#
#   EMAIL_TRANSACTIONAL_FROM -- system/transactional mail (subscription
#     confirmations, contact acknowledgements, ticket resolutions).
#     Default: "The Eurovillage Herald <noreply@eurovillageherald.com>"
#   EMAIL_BULLETIN_FROM -- editorial newsletters/campaigns, sent from the
#     news subdomain so a bulletin-sending problem can never affect the
#     root domain's deliverability reputation.
#     Default: "The Eurovillage Herald <bulletin@news.eurovillageherald.com>"
#   EMAIL_CONTACT_REPLY_TO -- the Reply-To header set on contact-flavored
#     transactional mail ONLY. This MUST be the real, existing Zoho-hosted
#     human mailbox -- setting it here only tells outgoing mail where a
#     reply should land; it does not create, host, or touch that mailbox
#     in any way, and no MX/DNS record is changed by this app.
#     Default: iletisim@eurovillageherald.com
EMAIL_TRANSACTIONAL_FROM=
EMAIL_BULLETIN_FROM=
EMAIL_CONTACT_REPLY_TO=

# --- Provider: Resend (EMAIL_PROVIDER=resend) -------------------------------
# The free-tier provider this project intends to start with. Requires
# verifying BOTH eurovillageherald.com (for EMAIL_TRANSACTIONAL_FROM) and
# news.eurovillageherald.com (for EMAIL_BULLETIN_FROM) as sending domains
# in the Resend dashboard -- Resend will show you the exact SPF/DKIM (TXT)
# and, if you want bounce/webhook tracking, additional DNS records to add
# in Cloudflare for EACH domain. This app does NOT invent or auto-apply
# those records -- copy them from the Resend dashboard into Cloudflare DNS
# yourself (or hand them to whoever manages eurovillageherald.com's DNS).
# NEVER commit the real key below.
EMAIL_API_KEY=

# --- Provider: SMTP (EMAIL_PROVIDER=smtp) -----------------------------------
# Works with nearly any real SMTP-speaking provider or mailbox (Postmark,
# SendGrid, Mailgun, Amazon SES, a Google Workspace account with an app
# password, etc.) as an alternative to Resend.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# "false" to use implicit TLS (SMTPS, usually port 465) instead of STARTTLS
# on the port above. Optional, defaults to true (STARTTLS).
SMTP_USE_TLS=true

# ---------------------------------------------------------------------------
# Email outbox draining (app/outbox.py) -- OPTIONAL Railway Cron hook
# ---------------------------------------------------------------------------
# The durable email outbox is drained opportunistically on ordinary page
# loads (the same restart-safe pattern already used for scheduled issue
# publishing) plus a manual "Kuyruğu Şimdi İşle" button in
# /admin/eposta-sistemi -- on a site with any regular traffic, that alone
# keeps the queue moving without any extra infrastructure.
#
# If the site's natural traffic is ever too low for that (e.g. a long
# overnight gap with no admin or reader visits and a scheduled bulletin
# waiting), you can additionally point a Railway Cron job at
# POST /internal/e-posta/isle with header
# "Authorization: Bearer <EMAIL_OUTBOX_CRON_TOKEN>" every few minutes.
# Leaving this unset makes that endpoint 404 (not silently accept
# anything) -- it is entirely inert until you deliberately set a token AND
# configure the Cron job in the Railway dashboard yourself; this app does
# not and cannot create that Cron job for you.
EMAIL_OUTBOX_CRON_TOKEN=


# ---------------------------------------------------------------------------
# Editorial draft automation (app/drafts.py)
# ---------------------------------------------------------------------------
# Nothing generated by this feature is ever published automatically --
# every draft (issue announcement, newsletter intro, social copy, etc.)
# requires an explicit human "mark as used" action in /admin/taslaklar.
#
# Left unset, drafts are generated by a deterministic, template-based
# baseline (no external calls, no API key needed, works out of the box).
# This variable does not currently connect to any real AI provider --
# no such integration is wired up in this codebase -- it only records
# operator intent as a single flag for a future integration to branch on
# (see app/drafts.py's AI_ENABLED). Setting it today has no effect beyond
# labeling generated drafts "generated_by": "ai" instead of "template".
AI_DRAFT_PROVIDER=
